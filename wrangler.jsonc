{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Custom entry: wraps the OpenNext handler and adds the `scheduled` cron handler
  "main": "worker.ts",
  "name": "ys-jasstafel",
  // Cloudflare account "yannicksalm.ch"
  "account_id": "b7cc1bc9eeaec1c7dd4e9308c4c7cfc5",
  // Custom domain: Cloudflare creates the DNS record and certificate
  "routes": [{ "pattern": "jasstafel.yannicksalm.ch", "custom_domain": true }],
  "compatibility_date": "2026-04-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Weekly heartbeat (Monday 03:00 UTC) so the Supabase free tier doesn't pause
  "triggers": {
    "crons": ["0 3 * * 1"]
  },
  "observability": { "enabled": true },
  // Used by the heartbeat cron in worker.ts (not secret)
  "vars": {
    "SUPABASE_URL": "https://bpltkzvidnktxkgffxjf.supabase.co"
  }
  // Secret (wrangler secret put): SUPABASE_SERVICE_ROLE_KEY
}
